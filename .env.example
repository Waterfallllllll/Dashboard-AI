# Application
NODE_ENV=development
APP_ORIGIN=http://localhost:3000
NEXT_PUBLIC_APP_URL=http://localhost:3000
INTERNAL_API_URL=http://localhost:4000
DEPLOYMENT_VERSION=local

# API
PORT=4000
TRUST_PROXY_HOPS=1
CORS_ALLOWED_ORIGINS=http://localhost:3000
LOG_LEVEL=info

# PostgreSQL
# Локальный пароль совпадает с infra/compose.dev.yml. В production адрес берётся из secret storage.
DATABASE_URL=postgresql://dashboard:dashboard@localhost:5432/dashboard
# Прямое соединение для prisma migrate. На MVP совпадает с DATABASE_URL.
DIRECT_DATABASE_URL=postgresql://dashboard:dashboard@localhost:5432/dashboard

# Sessions and encryption
SESSION_SECRET=
# 32 bytes as base64 (43 chars plus padding) or hex (64 chars). AES-256-GCM for OAuth tokens, integration credentials and push keys.
DATA_ENCRYPTION_KEY=
NEXT_SERVER_ACTIONS_ENCRYPTION_KEY=

# Google OAuth and Calendar
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3000/api/v1/auth/google/callback
GOOGLE_CALENDAR_REDIRECT_URI=http://localhost:3000/api/v1/integrations/google/callback
GOOGLE_CALENDAR_WEBHOOK_URL=
GOOGLE_CALENDAR_WEBHOOK_TOKEN=

# Telegram
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=
TELEGRAM_WEBHOOK_SECRET=
TELEGRAM_WEBHOOK_URL=

# Web Push
WEB_PUSH_SUBJECT=mailto:admin@example.com
WEB_PUSH_PUBLIC_KEY=
WEB_PUSH_PRIVATE_KEY=
NEXT_PUBLIC_WEB_PUSH_PUBLIC_KEY=

# External providers
WEATHER_API_BASE_URL=https://api.open-meteo.com
NEWS_API_KEY=

# Worker
WORKER_ID=worker-local
JOB_POLL_INTERVAL_MS=1000
JOB_LEASE_DURATION_MS=30000
JOB_MAX_ATTEMPTS=5
JOB_RETENTION_DAYS=30
