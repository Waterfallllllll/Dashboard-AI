{
  "name": "@dashboard/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/main.ts",
    "dev:worker": "tsx watch src/worker-main.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/main.js",
    "start:worker": "node dist/worker-main.js",
    "typecheck": "tsc --noEmit",
    "db:ensure": "tsx src/infrastructure/mongodb/ensure-cli.ts",
    "db:migrate": "tsx src/infrastructure/mongodb/migrate-cli.ts",
    "test": "vitest run",
    "clean": "rimraf dist"
  },
  "dependencies": {
    "@dashboard/contracts": "*",
    "@date-fns/tz": "1.5.0",
    "@prometheus-io/client": "0.16.1",
    "compression": "1.8.2",
    "cookie-parser": "1.4.7",
    "cors": "2.8.6",
    "date-fns": "4.4.0",
    "dotenv": "18.0.8",
    "express": "5.3.0",
    "express-rate-limit": "8.7.1",
    "googleapis": "186.0.0",
    "helmet": "8.3.0",
    "mongodb": "7.7.0",
    "openid-client": "6.8.8",
    "pino": "10.4.0",
    "pino-http": "11.0.0",
    "rss-parser": "3.13.0",
    "web-push": "3.6.7",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/compression": "1.8.1",
    "@types/cookie-parser": "1.4.10",
    "@types/cors": "2.8.19",
    "@types/express": "5.0.6",
    "@types/supertest": "7.2.1",
    "@types/web-push": "3.6.4",
    "pino-pretty": "13.2.0",
    "supertest": "7.3.1",
    "tsx": "4.23.15"
  }
}
