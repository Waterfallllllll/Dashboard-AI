{
  "name": "evergreen-dashboard",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Персональный информационный дашборд",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "engines": {
    "node": ">=24.0.0 <25",
    "npm": ">=11.0.0"
  },
  "packageManager": "npm@11.17.0",
  "scripts": {
    "dev": "concurrently --kill-others-on-fail --names web,api,worker \"npm:dev:web\" \"npm:dev:api\" \"npm:dev:worker\"",
    "dev:web": "npm run dev --workspace @dashboard/web",
    "dev:api": "npm run dev --workspace @dashboard/api",
    "dev:worker": "npm run dev:worker --workspace @dashboard/api",
    "build": "npm run build --workspace @dashboard/contracts && npm run build --workspace @dashboard/api && npm run build --workspace @dashboard/web",
    "build:web": "npm run build --workspace @dashboard/web",
    "build:api": "npm run build --workspace @dashboard/api",
    "build:contracts": "npm run build --workspace @dashboard/contracts",
    "start:web": "npm run start --workspace @dashboard/web",
    "start:api": "npm run start --workspace @dashboard/api",
    "start:worker": "npm run start:worker --workspace @dashboard/api",
    "lint": "eslint .",
    "typecheck": "npm run build --workspace @dashboard/contracts && npm run typecheck --workspace @dashboard/contracts && npm run typecheck --workspace @dashboard/api && npm run typecheck --workspace @dashboard/web",
    "test": "npm run db:generate --workspace @dashboard/api && vitest run",
    "test:unit": "vitest run --project unit",
    "test:component": "vitest run --project component",
    "test:integration": "vitest run --project integration",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "npm run build:contracts && playwright test",
    "test:e2e:install": "playwright install chromium",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "env:secrets": "node scripts/ensure-local-secrets.mjs",
    "clean": "rimraf apps/*/.next apps/*/dist packages/*/dist coverage playwright-report test-results",
    "infra:up": "docker compose -f infra/compose.dev.yml up -d",
    "infra:down": "docker compose -f infra/compose.dev.yml down",
    "infra:logs": "docker compose -f infra/compose.dev.yml logs -f"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "@types/node": "24.19.2",
    "@vitejs/plugin-react": "5.2.0",
    "@vitest/coverage-v8": "5.0.5",
    "concurrently": "10.0.6",
    "eslint": "10.16.0",
    "jsdom": "30.1.3",
    "playwright": "1.64.1",
    "prettier": "3.9.10",
    "rimraf": "6.1.3",
    "typescript": "6.0.3",
    "vitest": "5.0.5"
  },
  "overrides": {
    "effect": "3.22.1"
  }
}
